# Neon Postgres connection string (get this from your Neon project dashboard)
# Format: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Random secret for NextAuth session/JWT signing — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Anthropic API key for the AI Assistant tab (server-side only, never exposed to browser)
ANTHROPIC_API_KEY=

# Optional: override FX rate provider
FX_API_URL=https://open.er-api.com/v6/latest/USD
